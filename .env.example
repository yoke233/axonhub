# docker-compose.yaml environment example for the 1Panel rollout deployment.

COMPOSE_PROJECT_NAME=axonhub

# Image pulled by 172.* internal servers. docker/publish.ps1 pushes the same
# repository through registry.cn-shanghai from the external-network machine.
AXONHUB_IMAGE=registry-vpc.cn-shanghai.aliyuncs.com/xiaoin/axonhub
AXONHUB_TAG=latest

# Traefik publishes AxonHub on the same host port used by the legacy container.
HTTP_PUBLISH_PORT=8123
TRAEFIK_LOG_LEVEL=INFO

# Database. Set the real DSN in the server .env; do not commit secrets.
AXONHUB_DB_DIALECT=mysql
AXONHUB_DB_DSN=mysql://axonhub:change-me@tcp(127.0.0.1:3306)/axonhub?parseTime=True

# Long LLM streaming requests.
AXONHUB_SERVER_LLM_REQUEST_TIMEOUT=1800s

# Rollout / graceful drain.
API_REPLICAS=1
ROLLOUT_TIMEOUT=180
API_DRAIN_PROPAGATION_SECONDS=10
API_STOP_GRACE_PERIOD=31m
AXONHUB_SERVER_APP_STOP_TIMEOUT=30m50s
AXONHUB_DRAIN_FILE=/tmp/drain
